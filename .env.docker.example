# Copie para .env para sobrescrever os padrões de desenvolvimento do compose.yaml.
# Em qualquer ambiente compartilhado, defina valores próprios e longos (mín. 16 caracteres).
POSTGRES_PASSWORD=
AUTH_USER_HEADER=x-forwarded-email
DATADOG_WEBHOOK_SECRET=
# Outras fontes de alertas (um segredo por fonte, mín. 16 caracteres; sem o segredo o webhook da fonte responde 401).
# CloudWatch: o segredo vai como senha na URL da assinatura do SNS; use só letras, números, - e _.
CLOUDWATCH_WEBHOOK_SECRET=
# Opcional: ARNs de tópico do SNS aceitos, separados por vírgula (vazio = qualquer tópico que conheça o segredo).
CLOUDWATCH_TOPIC_ARNS=
APPDYNAMICS_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=
REMEDIATION_ALLOWED_HOSTS=simulator:9100,simulator-demo:9100
SIMULATOR_REMEDIATION_TOKEN=
LOG_LEVEL=info
# Datadog real: DD_API_BASE_URL vazio (desliga o Datadog simulado), site e chaves reais.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_API_BASE_URL=
# Intervalo (s) do serviço opcional `reconciler` (perfil reconcile).
RECONCILE_EVERY=300
