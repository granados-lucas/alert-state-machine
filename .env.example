# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info
# Segredo enviado pelo Datadog no header X-Webhook-Secret (mín. 16 caracteres).
DATADOG_WEBHOOK_SECRET=
# Cabeçalho que o SSO corporativo na frente da aplicação preenche com a identidade do usuário (auditoria).
# A aplicação não autentica: ela só é segura atrás do SSO. Padrão: x-forwarded-email.
AUTH_USER_HEADER=x-forwarded-email
# Destinos permitidos para remediação (host ou host:porta, separados por vírgula). Vazio bloqueia tudo.
REMEDIATION_ALLOWED_HOSTS=
# Valores referenciados por headers de remediação "env:NOME" (exemplo).
# REMEDIATION_TOKEN_EXAMPLE=
# API do Datadog para silenciar monitores (permissão monitors_write). Sem as duas chaves o recurso fica desligado.
DD_API_KEY=
DD_APP_KEY=
# Site do Datadog (datadoghq.com, datadoghq.eu, us3.datadoghq.com, ...). DD_API_BASE_URL substitui o destino (testes).
DD_SITE=datadoghq.com
DD_API_BASE_URL=
